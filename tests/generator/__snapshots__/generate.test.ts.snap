      "inputs": ["default", "^production"],
      "cache": true
    },
    "lint": {
      "inputs": ["default"],
      "cache": true
    },
    "typecheck": {
      "inputs": ["default", "^default"],
      "cache": true
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  },
  "plugins": ["@nx-go/nx-go"]
}
"
`;

