# ─── App ───────────────────────────────────────────
NODE_ENV=development
APP_NAME={{config.name}}

# ─── Frontend ──────────────────────────────────────
{{#each config.frontend.apps}}
{{#ifEquals this.type "next-ssr"}}
NEXT_PUBLIC_API_URL=http://localhost:4000
{{/ifEquals}}
{{#ifEquals this.type "vite-spa"}}
VITE_API_URL=http://localhost:4000
{{/ifEquals}}
{{/each}}
{{#ifEquals config.auth "clerk"}}

# ─── Auth (Clerk) ─────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
{{/ifEquals}}
{{#ifEquals config.auth "auth0"}}

# ─── Auth (Auth0) ─────────────────────────────────
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_CLIENT_ID=xxx
AUTH0_CLIENT_SECRET=xxx
AUTH0_AUDIENCE=https://api.{{config.name}}.com
{{/ifEquals}}
{{#ifEquals config.database.type "postgres"}}

# ─── Database ─────────────────────────────────────
DATABASE_URL=postgres://postgres:postgres@localhost:5432/{{config.name}}
{{/ifEquals}}
{{#ifIncludes config.allStackIds "drizzle"}}

# ─── Drizzle ──────────────────────────────────────
DRIZZLE_DATABASE_URL=postgres://postgres:postgres@localhost:5432/{{config.name}}
{{/ifIncludes}}
{{#if config.needsDocker}}

# ─── Redis ────────────────────────────────────────
REDIS_URL=redis://localhost:6379
{{/if}}
{{#ifEquals config.hosting "aws"}}

# ─── AWS ──────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
{{/ifEquals}}
{{#ifEquals config.hosting "gcp"}}

# ─── GCP ──────────────────────────────────────────
GCP_PROJECT_ID=
GCP_REGION=us-central1
{{/ifEquals}}
