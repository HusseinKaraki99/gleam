name: CI

on:
  push:
    branches: [main]
  pull_request:
    branches: [main]

concurrency:
  group: ${{"{{"}} github.workflow {{"}}"}}-${{"{{"}} github.ref {{"}}"}}
  cancel-in-progress: true

jobs:
  lint:
    name: Lint
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: pnpm/action-setup@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 22
          cache: pnpm
      - run: pnpm install --frozen-lockfile
      - run: pnpm lint
{{#if config.needsGoWork}}

  lint-go:
    name: Lint Go
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-go@v5
        with:
          go-version: "1.24"
      - uses: golangci/golangci-lint-action@v6
        with:
          version: latest
{{/if}}

  typecheck:
    name: Type Check
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: pnpm/action-setup@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 22
          cache: pnpm
      - run: pnpm install --frozen-lockfile
      - run: pnpm typecheck

  test:
    name: Test
    runs-on: ubuntu-latest
{{#ifEquals config.database.type "postgres"}}
    services:
      postgres:
        image: postgres:17-alpine
        env:
          POSTGRES_DB: {{config.name}}_test
          POSTGRES_USER: postgres
          POSTGRES_PASSWORD: postgres
        ports:
          - 5432:5432
        options: >-
          --health-cmd pg_isready
          --health-interval 10s
          --health-timeout 5s
          --health-retries 5
{{/ifEquals}}
    steps:
      - uses: actions/checkout@v4
      - uses: pnpm/action-setup@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 22
          cache: pnpm
      - run: pnpm install --frozen-lockfile
      - run: pnpm test
{{#ifEquals config.database.type "postgres"}}
        env:
          DATABASE_URL: postgres://postgres:postgres@localhost:5432/{{config.name}}_test
{{/ifEquals}}
{{#if config.needsGoWork}}

  test-go:
    name: Test Go
    runs-on: ubuntu-latest
{{#ifEquals config.database.type "postgres"}}
    services:
      postgres:
        image: postgres:17-alpine
        env:
          POSTGRES_DB: {{config.name}}_test
          POSTGRES_USER: postgres
          POSTGRES_PASSWORD: postgres
        ports:
          - 5432:5432
        options: >-
          --health-cmd pg_isready
          --health-interval 10s
          --health-timeout 5s
          --health-retries 5
{{/ifEquals}}
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-go@v5
        with:
          go-version: "1.24"
      - run: go test ./... -v -race -coverprofile=coverage.out
{{#ifEquals config.database.type "postgres"}}
        env:
          DATABASE_URL: postgres://postgres:postgres@localhost:5432/{{config.name}}_test
{{/ifEquals}}
{{/if}}

  build:
    name: Build
    runs-on: ubuntu-latest
    needs: [lint, typecheck, test]
    steps:
      - uses: actions/checkout@v4
      - uses: pnpm/action-setup@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 22
          cache: pnpm
      - run: pnpm install --frozen-lockfile
      - run: pnpm build
{{#if config.needsGoWork}}
      - uses: actions/setup-go@v5
        with:
          go-version: "1.24"
      - run: go build ./...
{{/if}}
{{#ifIncludes config.allStackIds "dotnet"}}

  build-dotnet:
    name: Build .NET
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-dotnet@v4
        with:
          dotnet-version: "9.0.x"
      - run: dotnet build --configuration Release
      - run: dotnet test --configuration Release --no-build
{{/ifIncludes}}
