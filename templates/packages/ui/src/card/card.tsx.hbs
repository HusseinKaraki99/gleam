import * as React from 'react';
import { cva, type VariantProps } from 'class-variance-authority';
import { cn } from '../primitives/cn';
import type { ComponentMeta } from '../component-meta';

/* ------------------------------------------------------------------ */
/* Variants                                                            */
/* ------------------------------------------------------------------ */
const cardVariants = cva(
  'rounded-[var(--radius-lg)] transition-[box-shadow,border-color] duration-[var(--duration-fast)]',
  {
    variants: {
      variant: {
        default:
          'bg-[var(--color-bg)] border border-[var(--color-border)] shadow-[var(--shadow-sm)]',
        bordered:
          'bg-[var(--color-bg)] border-2 border-[var(--color-border)]',
        elevated:
          'bg-[var(--color-bg)] shadow-[var(--shadow-md)]',
      },
      padding: {
        none: '',
        sm: 'p-[var(--space-4)]',
        md: 'p-[var(--space-6)]',
        lg: 'p-[var(--space-8)]',
      },
    },
    defaultVariants: {
      variant: 'default',
      padding: 'md',
    },
  },
);

/* ------------------------------------------------------------------ */
/* Component                                                           */
/* ------------------------------------------------------------------ */
export interface CardProps
  extends React.HTMLAttributes<HTMLDivElement>,
    VariantProps<typeof cardVariants> {}

export const Card = React.forwardRef<HTMLDivElement, CardProps>(
  ({ className, variant, padding, ...props }, ref) => (
    <div
      ref={ref}
      className={cn(cardVariants({ variant, padding }), className)}
      {...props}
    />
  ),
);

Card.displayName = 'Card';

/* ------------------------------------------------------------------ */
/* Sub-components                                                      */
/* ------------------------------------------------------------------ */
export const CardHeader = React.forwardRef<
  HTMLDivElement,
  React.HTMLAttributes<HTMLDivElement>
>(({ className, ...props }, ref) => (
  <div
    ref={ref}
    className={cn('flex flex-col gap-[var(--space-1)]', className)}
    {...props}
  />
));
CardHeader.displayName = 'CardHeader';

export const CardTitle = React.forwardRef<
  HTMLHeadingElement,
  React.HTMLAttributes<HTMLHeadingElement>
>(({ className, ...props }, ref) => (
  <h3
    ref={ref}
    className={cn(
      'text-[var(--text-lg)] font-[var(--font-semibold)] leading-[var(--leading-lg)] text-[var(--color-fg)]',
      className,
    )}
    {...props}
  />
));
CardTitle.displayName = 'CardTitle';

export const CardContent = React.forwardRef<
  HTMLDivElement,
  React.HTMLAttributes<HTMLDivElement>
>(({ className, ...props }, ref) => (
  <div
    ref={ref}
    className={cn('text-[var(--text-sm)] text-[var(--color-fg-muted)]', className)}
    {...props}
  />
));
CardContent.displayName = 'CardContent';

export const CardFooter = React.forwardRef<
  HTMLDivElement,
  React.HTMLAttributes<HTMLDivElement>
>(({ className, ...props }, ref) => (
  <div
    ref={ref}
    className={cn('flex items-center gap-[var(--space-2)] pt-[var(--space-4)]', className)}
    {...props}
  />
));
CardFooter.displayName = 'CardFooter';

/* ------------------------------------------------------------------ */
/* Metadata                                                            */
/* ------------------------------------------------------------------ */
export const meta: ComponentMeta = {
  name: 'Card',
  description: 'A surface container for grouping related content with optional header, body, and footer slots.',
  variants: {
    variant: ['default', 'bordered', 'elevated'],
    padding: ['none', 'sm', 'md', 'lg'],
  },
  defaultVariant: {
    variant: 'default',
    padding: 'md',
  },
  slots: ['children', 'header', 'footer'],
  accessibilityRole: 'region',
};
