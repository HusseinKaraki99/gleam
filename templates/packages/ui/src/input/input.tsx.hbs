import * as React from 'react';
import { cn } from '../primitives/cn';
import type { ComponentMeta } from '../component-meta';

/* ------------------------------------------------------------------ */
/* Component                                                           */
/* ------------------------------------------------------------------ */
export interface InputProps
  extends Omit<React.InputHTMLAttributes<HTMLInputElement>, 'size'> {
  /** Visible label text */
  label?: string;
  /** Error message — shown below the input and sets aria-invalid */
  error?: string;
  /** Hint text shown below the input when no error is present */
  hint?: string;
  /** Visual size variant */
  size?: 'sm' | 'md' | 'lg';
}

export const Input = React.forwardRef<HTMLInputElement, InputProps>(
  ({ className, label, error, hint, size = 'md', id: idProp, required, ...props }, ref) => {
    const generatedId = React.useId();
    const id = idProp ?? generatedId;
    const errorId = `${id}-error`;
    const hintId = `${id}-hint`;

    const sizeClasses = {
      sm: 'h-8 px-[var(--space-2)] text-[var(--text-xs)]',
      md: 'h-10 px-[var(--space-3)] text-[var(--text-sm)]',
      lg: 'h-12 px-[var(--space-4)] text-[var(--text-base)]',
    };

    return (
      <div className="flex flex-col gap-[var(--space-1)]">
        {label && (
          <label
            htmlFor={id}
            className="text-[var(--text-sm)] font-[var(--font-medium)] text-[var(--color-fg)]"
          >
            {label}
            {required && (
              <span className="ml-[var(--space-1)] text-[var(--color-destructive)]" aria-hidden="true">
                *
              </span>
            )}
          </label>
        )}

        <input
          ref={ref}
          id={id}
          required={required}
          aria-invalid={error ? true : undefined}
          aria-describedby={
            error ? errorId : hint ? hintId : undefined
          }
          className={cn(
            'w-full rounded-[var(--radius-md)] border bg-[var(--color-bg)] font-[var(--font-sans)]',
            'text-[var(--color-fg)] placeholder:text-[var(--color-fg-subtle)]',
            'transition-[border-color,box-shadow] duration-[var(--duration-fast)]',
            'focus:outline-none focus:ring-2 focus:ring-[var(--color-border-focus)] focus:border-[var(--color-border-focus)]',
            'disabled:cursor-not-allowed disabled:opacity-50',
            error
              ? 'border-[var(--color-destructive)] focus:ring-[var(--color-destructive)]'
              : 'border-[var(--color-border)]',
            sizeClasses[size],
            className,
          )}
          {...props}
        />

        {error && (
          <p id={errorId} className="text-[var(--text-xs)] text-[var(--color-destructive)]" role="alert">
            {error}
          </p>
        )}

        {!error && hint && (
          <p id={hintId} className="text-[var(--text-xs)] text-[var(--color-fg-subtle)]">
            {hint}
          </p>
        )}
      </div>
    );
  },
);

Input.displayName = 'Input';

/* ------------------------------------------------------------------ */
/* Metadata                                                            */
/* ------------------------------------------------------------------ */
export const meta: ComponentMeta = {
  name: 'Input',
  description: 'A text input field with optional label, error state, hint text, and required indicator.',
  variants: {
    size: ['sm', 'md', 'lg'],
  },
  defaultVariant: {
    size: 'md',
  },
  slots: ['label', 'error', 'hint'],
  accessibilityRole: 'textbox',
};
