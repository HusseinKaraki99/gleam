/**
 * Design Tokens for {{project.displayName}}
 *
 * Generated by Gleam — do not edit manually.
 * Brand hue: {{config.design.brandHue}}
 * Personality: {{config.design.personality}}
 * Motion: {{config.design.motionLevel}}
 *
 * Color system: OKLCH for perceptual uniformity
 * Grid: 4px base
 */

/* ------------------------------------------------------------------ */
/* Fonts                                                               */
/* ------------------------------------------------------------------ */
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap');

/* ------------------------------------------------------------------ */
/* Tailwind v4 theme                                                   */
/* ------------------------------------------------------------------ */
@theme {
  /* ================================================================ */
  /* COLOR SCALES — OKLCH (lightness chroma hue)                      */
  /* ================================================================ */

  /* --- Primary scale (12 steps) — brand hue {{config.design.brandHue}} --- */
  --color-primary-1:  oklch(0.98 0.01 {{config.design.brandHue}});
  --color-primary-2:  oklch(0.95 0.02 {{config.design.brandHue}});
  --color-primary-3:  oklch(0.90 0.04 {{config.design.brandHue}});
  --color-primary-4:  oklch(0.85 0.06 {{config.design.brandHue}});
  --color-primary-5:  oklch(0.78 0.08 {{config.design.brandHue}});
  --color-primary-6:  oklch(0.70 0.10 {{config.design.brandHue}});
  --color-primary-7:  oklch(0.62 0.12 {{config.design.brandHue}});
  --color-primary-8:  oklch(0.55 0.14 {{config.design.brandHue}});
  --color-primary-9:  oklch(0.49 0.15 {{config.design.brandHue}});
  --color-primary-10: oklch(0.42 0.13 {{config.design.brandHue}});
  --color-primary-11: oklch(0.35 0.11 {{config.design.brandHue}});
  --color-primary-12: oklch(0.27 0.08 {{config.design.brandHue}});

  /* --- Neutral scale (12 steps) — warm-tinted gray (hue {{config.design.brandHue}}, low chroma) --- */
  --color-neutral-1:  oklch(0.99 0.003 {{config.design.brandHue}});
  --color-neutral-2:  oklch(0.96 0.005 {{config.design.brandHue}});
  --color-neutral-3:  oklch(0.92 0.006 {{config.design.brandHue}});
  --color-neutral-4:  oklch(0.87 0.007 {{config.design.brandHue}});
  --color-neutral-5:  oklch(0.80 0.008 {{config.design.brandHue}});
  --color-neutral-6:  oklch(0.71 0.009 {{config.design.brandHue}});
  --color-neutral-7:  oklch(0.60 0.010 {{config.design.brandHue}});
  --color-neutral-8:  oklch(0.50 0.010 {{config.design.brandHue}});
  --color-neutral-9:  oklch(0.40 0.010 {{config.design.brandHue}});
  --color-neutral-10: oklch(0.32 0.009 {{config.design.brandHue}});
  --color-neutral-11: oklch(0.25 0.008 {{config.design.brandHue}});
  --color-neutral-12: oklch(0.18 0.006 {{config.design.brandHue}});

  /* --- Semantic: success (hue 145) --- */
  --color-success-light: oklch(0.92 0.05 145);
  --color-success-base:  oklch(0.60 0.14 145);
  --color-success-dark:  oklch(0.40 0.10 145);

  /* --- Semantic: warning (hue 70) --- */
  --color-warning-light: oklch(0.93 0.06 70);
  --color-warning-base:  oklch(0.75 0.14 70);
  --color-warning-dark:  oklch(0.50 0.10 70);

  /* --- Semantic: danger (hue 25) --- */
  --color-danger-light: oklch(0.92 0.04 25);
  --color-danger-base:  oklch(0.58 0.16 25);
  --color-danger-dark:  oklch(0.40 0.12 25);

  /* --- Semantic: info (hue 230) --- */
  --color-info-light: oklch(0.93 0.04 230);
  --color-info-base:  oklch(0.58 0.14 230);
  --color-info-dark:  oklch(0.40 0.10 230);

  /* ================================================================ */
  /* COLOR ALIASES                                                     */
  /* ================================================================ */
  --color-bg:             var(--color-neutral-1);
  --color-bg-subtle:      var(--color-neutral-2);
  --color-bg-muted:       var(--color-neutral-3);
  --color-fg:             var(--color-neutral-12);
  --color-fg-muted:       var(--color-neutral-10);
  --color-fg-subtle:      var(--color-neutral-8);
  --color-accent:         var(--color-primary-9);
  --color-accent-fg:      var(--color-primary-1);
  --color-accent-subtle:  var(--color-primary-3);
  --color-border:         var(--color-neutral-4);
  --color-border-focus:   var(--color-primary-7);
  --color-destructive:    var(--color-danger-base);
  --color-success:        var(--color-success-base);
  --color-warning:        var(--color-warning-base);

  /* ================================================================ */
  /* TYPOGRAPHY                                                        */
  /* ================================================================ */
  --font-sans: 'Inter', ui-sans-serif, system-ui, -apple-system, sans-serif;
  --font-mono: 'JetBrains Mono', ui-monospace, 'Cascadia Code', monospace;

  --text-xs:   0.75rem;
  --text-sm:   0.875rem;
  --text-base: 1rem;
  --text-lg:   1.125rem;
  --text-xl:   1.25rem;
  --text-2xl:  1.5rem;
  --text-3xl:  1.875rem;
  --text-4xl:  2.25rem;

  --leading-xs:   1rem;
  --leading-sm:   1.25rem;
  --leading-base: 1.5rem;
  --leading-lg:   1.75rem;
  --leading-xl:   1.75rem;
  --leading-2xl:  2rem;
  --leading-3xl:  2.25rem;
  --leading-4xl:  2.5rem;

  --font-normal:   400;
  --font-medium:   500;
  --font-semibold: 600;
  --font-bold:     700;

  /* ================================================================ */
  /* SPACING — 4px base grid                                           */
  /* ================================================================ */
  --space-0:  0px;
  --space-1:  4px;
  --space-2:  8px;
  --space-3:  12px;
  --space-4:  16px;
  --space-5:  20px;
  --space-6:  24px;
  --space-7:  28px;
  --space-8:  32px;
  --space-9:  36px;
  --space-10: 40px;
  --space-11: 44px;
  --space-12: 48px;
  --space-14: 56px;
  --space-16: 64px;

  /* ================================================================ */
  /* BORDER RADIUS — personality-dependent                             */
  /* ================================================================ */
{{#ifEquals config.design.personality "professional"}}
  --radius-sm:   4px;
  --radius-md:   6px;
  --radius-lg:   8px;
  --radius-full: 9999px;
{{/ifEquals}}
{{#ifEquals config.design.personality "playful"}}
  --radius-sm:   8px;
  --radius-md:   12px;
  --radius-lg:   16px;
  --radius-full: 9999px;
{{/ifEquals}}
{{#ifEquals config.design.personality "minimal"}}
  --radius-sm:   2px;
  --radius-md:   4px;
  --radius-lg:   6px;
  --radius-full: 9999px;
{{/ifEquals}}
{{#ifEquals config.design.personality "bold"}}
  --radius-sm:   0px;
  --radius-md:   0px;
  --radius-lg:   0px;
  --radius-full: 9999px;
{{/ifEquals}}

  /* ================================================================ */
  /* SHADOWS                                                           */
  /* ================================================================ */
{{#ifEquals config.design.personality "minimal"}}
  --shadow-sm:  0 1px 2px 0 oklch(0 0 0 / 0.03);
  --shadow-md:  0 2px 6px -1px oklch(0 0 0 / 0.06), 0 1px 3px -1px oklch(0 0 0 / 0.04);
  --shadow-lg:  0 6px 16px -4px oklch(0 0 0 / 0.08), 0 2px 6px -2px oklch(0 0 0 / 0.04);
{{else}}
  {{#ifEquals config.design.personality "bold"}}
  --shadow-sm:  0 1px 3px 0 oklch(0 0 0 / 0.08), 0 1px 2px -1px oklch(0 0 0 / 0.06);
  --shadow-md:  0 4px 10px -2px oklch(0 0 0 / 0.12), 0 2px 4px -2px oklch(0 0 0 / 0.06);
  --shadow-lg:  0 10px 28px -6px oklch(0 0 0 / 0.16), 0 4px 10px -4px oklch(0 0 0 / 0.06);
  {{else}}
  --shadow-sm:  0 1px 2px 0 oklch(0 0 0 / 0.05);
  --shadow-md:  0 4px 8px -2px oklch(0 0 0 / 0.08), 0 2px 4px -2px oklch(0 0 0 / 0.04);
  --shadow-lg:  0 8px 24px -6px oklch(0 0 0 / 0.12), 0 4px 8px -4px oklch(0 0 0 / 0.05);
  {{/ifEquals}}
{{/ifEquals}}

  /* ================================================================ */
  /* MOTION                                                            */
  /* ================================================================ */
{{#ifEquals config.design.motionLevel "none"}}
  --duration-instant: 0ms;
  --duration-micro:   0ms;
  --duration-fast:    0ms;
  --duration-normal:  0ms;
  --duration-slow:    0ms;
  --ease-out:         linear;
  --ease-in-out:      linear;
{{else}}
  {{#ifEquals config.design.motionLevel "subtle"}}
  --duration-instant: 40ms;
  --duration-micro:   60ms;
  --duration-fast:    100ms;
  --duration-normal:  150ms;
  --duration-slow:    250ms;
  {{else}}
  --duration-instant: 80ms;
  --duration-micro:   120ms;
  --duration-fast:    200ms;
  --duration-normal:  300ms;
  --duration-slow:    500ms;
  {{/ifEquals}}
  --ease-out:    cubic-bezier(0.16, 1, 0.3, 1);
  --ease-in-out: cubic-bezier(0.65, 0, 0.35, 1);
{{/ifEquals}}
}

/* ==================================================================== */
/* DARK MODE                                                             */
/* ==================================================================== */
[data-theme="dark"] {
  /* Remap neutral aliases — invert the scale */
  --color-bg:             var(--color-neutral-12);
  --color-bg-subtle:      var(--color-neutral-11);
  --color-bg-muted:       var(--color-neutral-10);
  --color-fg:             var(--color-neutral-1);
  --color-fg-muted:       var(--color-neutral-3);
  --color-fg-subtle:      var(--color-neutral-5);

  /* Accent stays vibrant but lighten for dark backgrounds */
  --color-accent:         var(--color-primary-6);
  --color-accent-fg:      var(--color-primary-12);
  --color-accent-subtle:  var(--color-primary-10);

  /* Borders lighten in dark mode */
  --color-border:         var(--color-neutral-9);
  --color-border-focus:   var(--color-primary-6);

  /* Semantic — use lighter variants for dark backgrounds */
  --color-destructive:    oklch(0.65 0.16 25);
  --color-success:        oklch(0.65 0.14 145);
  --color-warning:        oklch(0.80 0.14 70);

  /* Shadows use lighter opacity on dark backgrounds */
  --shadow-sm:  0 1px 2px 0 oklch(0 0 0 / 0.30);
  --shadow-md:  0 4px 8px -2px oklch(0 0 0 / 0.40), 0 2px 4px -2px oklch(0 0 0 / 0.25);
  --shadow-lg:  0 8px 24px -6px oklch(0 0 0 / 0.50), 0 4px 8px -4px oklch(0 0 0 / 0.30);
}
