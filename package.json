{
  "name": "gleam",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI-agent-driven engineering template system for Claude Code",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "generate": "tsc && node dist/generate.js",
    "build:bundle": "node scripts/bundle.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "handlebars": "^4.7.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.28.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
